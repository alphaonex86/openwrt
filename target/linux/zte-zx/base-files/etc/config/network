config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix 'auto'

# The F680's four LAN sockets (eth0-3, the stock kernel's names) bridged; its declared lab address
# (ONU_LAN_IP of instrument/ZX279128/ZTE/F680/config.xml), never the banned .1.
config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth0'
	list ports 'eth1'
	list ports 'eth2'
	list ports 'eth3'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.1.14'
	option netmask '255.255.255.0'
	option ip6assign '60'
	list ip6class 'local'
