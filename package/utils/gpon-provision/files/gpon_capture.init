#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later
# With gpon.capture.boot=1: the OMCI/PLOAM capture rings from the first record of every boot, to RAM and
# to gpon.capture.collector (addr port, UDP) -- the GPON start a follower over ssh arrives too late for.

START=11
USE_PROCD=1

start_service() {
	local collector
	[ "$(uci -q get gpon.capture.boot)" = 1 ] || return 0
	collector=$(uci -q get gpon.capture.collector)
	procd_open_instance
	procd_set_param command /usr/sbin/gpon-capture -m "$(($(uci -q get gpon.capture.max_kb || echo 1024) * 1024))"
	[ -n "$collector" ] && procd_append_param command -c "${collector% *}" -P "${collector##* }"
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}
