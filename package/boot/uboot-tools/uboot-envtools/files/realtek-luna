[ -e /etc/config/ubootenv ] && exit 0

touch /etc/config/ubootenv

. /lib/uboot-envtools.sh
. /lib/functions.sh

board=$(board_name)

case "$board" in
unknown,rtl9607c-unknown)
	# Redundant environment, 16 KiB in each 128 KiB NAND block.
	ubootenv_add_mtd "env" "0x0" "0x4000" "0x20000" "1"
	ubootenv_add_mtd "env2" "0x0" "0x4000" "0x20000" "1"
	;;
esac

config_load ubootenv
config_foreach ubootenv_add_app_config

exit 0
