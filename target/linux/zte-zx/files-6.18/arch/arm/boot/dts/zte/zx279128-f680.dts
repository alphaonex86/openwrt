/dts-v1/;

#include "zx279128.dtsi"

/ {
	model = "ZTE ZXHN F680";
	compatible = "zte,f680", "zte,zx279128";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		bootargs = "console=ttyAMA0,115200";
		stdout-path = "serial0:115200n8";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x40000000 0x8000000>;
	};

	/*
	 * The panel lamps on SoC GPIO, all active low: stock's board table (board id 20, read from the eight strap pins
	 * 59-64/20/21) sets every lamp output high at init but POWER, and its LED commands index that same table.
	 * LAN1-4 (GPIO 49-52) stay muxed to the switch, which drives them; PON/LOS colours are the stock behaviour.
	 */
	leds {
		compatible = "gpio-leds";

		led-power {
			label = "f680:green:power";
			gpios = <&gpio1 3 1>;
			default-state = "on";
		};

		led-pon {
			label = "f680:green:pon";
			gpios = <&gpio3 0 1>;
			default-state = "off";
		};

		led-los {
			label = "f680:red:los";
			gpios = <&gpio2 15 1>;
			default-state = "off";
		};

		led-net {
			label = "f680:green:net";
			gpios = <&gpio3 8 1>;
			default-state = "off";
		};

		led-wlan {
			label = "f680:green:wlan";
			gpios = <&gpio1 2 1>;
			default-state = "off";
		};

		led-wps {
			label = "f680:green:wps";
			gpios = <&gpio3 5 1>;
			default-state = "off";
		};

		led-usb {
			label = "f680:green:usb";
			gpios = <&gpio3 10 1>;
			default-state = "off";
		};

		led-fxs1 {
			label = "f680:green:fxs1";
			gpios = <&gpio3 6 1>;
			default-state = "off";
		};
	};
};

/* The GN25L95 BOSA: its SFF-8472 pages at 0x50/0x51, configured from its own memory (stock never writes it). */
&i2c0 {
	status = "okay";

	optics: bosa@51 {
		compatible = "semtech,gn25l95";
		reg = <0x51>;
	};
};

/*
 * GPIO 72 is the BOSA's TX_DISABLE (A2h 0x6e bit 7 follows it): low transmits, as stock's board table drives it.
 * The stock U-Boot holds it high; the GPON driver keeps it high until its transmitter is enabled.
 */
&eth {
	laser-enable-gpios = <&gpio4 8 1>;
	optics = <&optics>;
};
