 	int status = -1;
 
+#ifdef CONFIG_CPU_R3K_TLB
+	/*
+	 * Emulate the SPECIAL2 / conditional-trap opcodes the RLX core lacks.
+	 * This runs before die_if_kernel() below because mips32-built kernel
+	 * code contains these instructions too, and like the R2 fast path it
+	 * returns before exception_enter().
+	 */
