#!/bin/sh
# The internet lamp (green:net): lit while an interface netifd holds up carries an
# IPv4 default route, the rule the X400AXF's led-panel applies to its NET lamp.
# netifd, not /proc/net/route: on ifdown the kernel still holds the route. A board
# without the lamp: no-op.
led=/sys/class/leds/green:net/brightness
[ -e "$led" ] || exit 0
ubus call network.interface dump |
	jsonfilter -e '@.interface[@.up=true].route[@.target="0.0.0.0" && @.mask=0].nexthop' >/dev/null &&
	on=1 || on=0
echo $on > "$led" || logger -t led-net "cannot set $led to $on"
exit 0
