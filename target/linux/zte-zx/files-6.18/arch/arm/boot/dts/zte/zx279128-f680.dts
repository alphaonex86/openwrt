/dts-v1/;

#include "zx279128.dtsi"

/ {
	model = "ZTE ZXHN F680";
	compatible = "zte,f680", "zte,zx279128";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		bootargs = "console=ttyAMA0,115200";
		stdout-path = "serial0:115200n8";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x40000000 0x8000000>;
	};
};
