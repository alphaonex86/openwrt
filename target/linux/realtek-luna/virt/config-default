# QEMU's Malta board replaces the SoC: its 8250 UART, GT64120 PCI host and virtio NICs on, the Luna drivers off.
CONFIG_MIPS_MALTA=y
# CONFIG_REALTEK_LUNA is not set
CONFIG_CPU_MIPS32_R2=y
# CONFIG_CPU_MIPS32_R1 is not set
CONFIG_CPU_MIPSR2=y
# CONFIG_CPU_MIPSR1 is not set
CONFIG_SYS_HAS_CPU_MIPS32_R2=y
CONFIG_MIPS_CMDLINE_FROM_BOOTLOADER=y
# CONFIG_MIPS_CMDLINE_DTB_EXTEND is not set
CONFIG_MIPS_NO_APPENDED_DTB=y
# CONFIG_MIPS_RAW_APPENDED_DTB is not set
# CONFIG_CMDLINE_BOOL is not set
CONFIG_CMDLINE=""
CONFIG_PCI_GT64XXX_PCI0=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LIB=y
CONFIG_VIRTIO_PCI_LIB_LEGACY=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_NET=y
CONFIG_NET_FAILOVER=y
CONFIG_FAILOVER=y
# The milestone reads ponvirt off the console: info level there, as on the elnath unit.
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=7
CONFIG_PON_VIRT=y
# The board userland reads its thread pointer with the RLX-only mflxc0; the 24Kc traps it.
CONFIG_MIPS_LXC0_TP_EMULATE=y
# CONFIG_LUNA_WDT is not set
# Malta's own tree resets through its FPGA's syscon-reboot node: without it a panic halts the unit for good.
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_MFD_SYSCON=y
# CONFIG_MTD_LUNA_NOR is not set
# The board squashfs is the root, mapped by phram from RAM outside the board's mem= ranges; the overlay is tmpfs.
CONFIG_MTD_PHRAM=y
# CONFIG_VIRTIO_BLK is not set
# CONFIG_VIRTIO_DEBUG is not set
# One CPU, as the RLX boards: no MT SMP on a 24Kc.
# CONFIG_MIPS_MT_SMP is not set
CONFIG_BUILTIN_DTB_NAME=""
CONFIG_ZBOOT_LOAD_ADDRESS=0x0
CONFIG_CLOCKSOURCE_WATCHDOG_MAX_SKEW_US=125
# CONFIG_CPU_MIPS32_R5 is not set
# CONFIG_CPU_MIPS32_R6 is not set
# CONFIG_CPU_MIPS64_R1 is not set
# CONFIG_CPU_MIPS64_R2 is not set
# CONFIG_CPU_MIPS64_R6 is not set
# CONFIG_CPU_NEVADA is not set
# CONFIG_CPU_RM7000 is not set
# CONFIG_CPU_MIPS32_3_5_FEATURES is not set
# CONFIG_CPU_MIPS32_R5_FEATURES is not set
# CONFIG_CPU_HAS_SMARTMIPS is not set
# CONFIG_CPU_MICROMIPS is not set
# CONFIG_NSM is not set
