// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
/*
 * V-SOL V1600G GPON OLT: Broadcom Hurricane2 BCM56150 host, 512 MiB DDR3 at 0x60000000.
 * Facts from its stock 1.9.7R: U-Boot "DRAM: 512 MiB", kernel "mem=496M", console = the UART at 0x18000300.
 */
/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include "bcm-hr2.dtsi"

/ {
	compatible = "vsol,v1600g", "brcm,bcm56150", "brcm,hr2";
	model = "V-SOL V1600G";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		bootargs = "earlycon";
		stdout-path = "serial0:115200n8";
	};

	memory@60000000 {
		device_type = "memory";
		reg = <0x60000000 0x1f000000>;
	};

	/* ChipcommonA GPIO: the stock kernel's lines 4-15; its interrupt is ChipcommonA's, shared with the UARTs */
	cca_gpio: gpio@18000060 {
		compatible = "brcm,iproc-gpio-cca";
		reg = <0x18000060 0x50>, <0x18000000 0x50>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <12>;
		interrupt-controller;
		#interrupt-cells = <2>;
		interrupts = <GIC_SPI 91 IRQ_TYPE_LEVEL_HIGH>;
	};

	/* the switch core's CMICd: its init replays the stock firmware's (its GPIO words below belong to cmic_gpio) */
	switch@48000000 {
		compatible = "brcm,bcm56150-switch";
		reg = <0x48000000 0x40000>;
	};

	/* the switch core's CMICd GPIO, the stock kernel's lines 0-3: input, output and output-enable words, no IRQ */
	cmic_gpio: gpio@48002000 {
		compatible = "brcm,bcm6345-gpio";
		reg = <0x48002000 4>, <0x48002004 4>, <0x48002008 4>;
		reg-names = "dat", "set", "dirout";
		gpio-controller;
		#gpio-cells = <2>;
	};

	/* ChipcommonB MII management, external pins: the management RJ45's PHY at address 3 (ID 0x001cc816, RTL8201F) */
	mdio@18032000 {
		compatible = "brcm,iproc-mdio";
		reg = <0x18032000 0x8>;
		brcm,external-bus;
		#address-cells = <1>;
		#size-cells = <0>;

		mgmt_phy: ethernet-phy@3 {
			reg = <3>;
		};
	};

	/*
	 * The board supervisor (stock: userWtd through vs_gpio_cfg lines 3 and 4): resets the board about 11 min after
	 * power-on unless fed. A 26-bit frame: bits 0-7 = 0xa5, bit 16 feeds (cleared: a reset within ~5 s), bits 18-25
	 * disable the laser of PON 1-8 (PON 1 = bit 18 measured; 2-8 by order, INFERRED: bit 25 is not PON 1), bit 17
	 * set by stock, 8-15 unknown. From probe: fed, every laser off (stock's boot words, without their 8-15 pattern).
	 */
	board_supervisor: board-watchdog {
		compatible = "gpio-frame-watchdog";
		clock-gpios = <&cmic_gpio 3 GPIO_ACTIVE_HIGH>;
		data-gpios = <&cca_gpio 0 GPIO_ACTIVE_HIGH>;
		frame-bits = <26>;
		frame-boot = <0x3ff00a5>;
		frame-fixed = <0x100ff>;
		gpio-controller;
		#gpio-cells = <2>;
		gpio-line-names = "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "watchdog-feed", "",
				  "pon1-tx-disable", "pon2-tx-disable", "pon3-tx-disable", "pon4-tx-disable",
				  "pon5-tx-disable", "pon6-tx-disable", "pon7-tx-disable", "pon8-tx-disable";
	};
};

/* the management RJ45 (U-Boot's GMAC0) */
&amac0 {
	phy-handle = <&mgmt_phy>;
	phy-mode = "mii";
	status = "okay";
};

/* the ZX279200 PON MAC (1556:5555, BAR0 decodes 256 MiB); the stock kernel's window: CPU 0x08000000 = bus 0x40000000 */
&pcie0 {
	compatible = "brcm,iproc-hr2-pcie";
	ranges = <0x82000000 0 0x40000000 0x08000000 0 0x08000000>;
	status = "okay";

	pcie@0,0 {
		device_type = "pci";
		reg = <0x0000 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		/* the PON MAC's links 0-7 = PON 1-8 */
		pon@0,0 {
			reg = <0x10000 0 0 0 0>;
			tx-disable-gpios = <&board_supervisor 18 GPIO_ACTIVE_HIGH>, <&board_supervisor 19 GPIO_ACTIVE_HIGH>,
					   <&board_supervisor 20 GPIO_ACTIVE_HIGH>, <&board_supervisor 21 GPIO_ACTIVE_HIGH>,
					   <&board_supervisor 22 GPIO_ACTIVE_HIGH>, <&board_supervisor 23 GPIO_ACTIVE_HIGH>,
					   <&board_supervisor 24 GPIO_ACTIVE_HIGH>, <&board_supervisor 25 GPIO_ACTIVE_HIGH>;
		};
	};
};

/* the UART runs on the 100 MHz APB clock: the unit's U-Boot divisor is 54 at 115200 */
&uart0 {
	clock-frequency = <100000000>;
	status = "okay";
};
