From: OpenWrt realtek-luna
Subject: jffs2: zlib decompress only

The zlib compressor kept its deflate workspace for life: 274 kB of vmalloc
on every Luna unit, for a 1-3 MB overlay. Writes now go to rtime (priority
50) or stay uncompressed, as LZMA writes already do (204). Reading stays:
the inflate side is untouched, and every zlib node of the lab and field
overlays (X111W and V2801RGW, lab and field; X100DG lab) decodes. Rewritten by
rtime, their live data takes +9 kB on a lab overlay and +87 kB on the field
X111W one (its 360 kB model.tsv), of 1 MB. ZLIB_DEFLATE is no longer
selected, so the deflate library leaves the kernel too.

--- a/fs/jffs2/Kconfig
+++ b/fs/jffs2/Kconfig
@@ -113,7 +113,6 @@
 config JFFS2_ZLIB
 	bool "JFFS2 ZLIB compression support" if JFFS2_COMPRESSION_OPTIONS
 	select ZLIB_INFLATE
-	select ZLIB_DEFLATE
 	depends on JFFS2_FS
 	default y
 	help
--- a/fs/jffs2/compr_zlib.c
+++ b/fs/jffs2/compr_zlib.c
@@ -22,18 +22,10 @@
 #include "nodelist.h"
 #include "compr.h"
 
-	/* Plan: call deflate() with avail_in == *sourcelen,
-		avail_out = *dstlen - 12 and flush == Z_FINISH.
-		If it doesn't manage to finish,	call it again with
-		avail_in == 0 and avail_out set to the remaining 12
-		bytes for it to clean up.
-	   Q: Is 12 bytes sufficient?
-	*/
-#define STREAM_END_SPACE 12
-
-static DEFINE_MUTEX(deflate_mutex);
+/* Decompress only: nodes written by zlib stay readable, new nodes go to the next compressor (rtime) or none,
+ * so the deflate workspace (274 kB vmalloc for life) is never allocated. */
 static DEFINE_MUTEX(inflate_mutex);
-static z_stream inf_strm, def_strm;
+static z_stream inf_strm;
 
 #ifdef __KERNEL__ /* Linux-only */
 #include <linux/vmalloc.h>
@@ -42,18 +34,9 @@
 
 static int __init alloc_workspaces(void)
 {
-	def_strm.workspace = vmalloc(zlib_deflate_workspacesize(MAX_WBITS,
-							MAX_MEM_LEVEL));
-	if (!def_strm.workspace)
-		return -ENOMEM;
-
-	jffs2_dbg(1, "Allocated %d bytes for deflate workspace\n",
-		  zlib_deflate_workspacesize(MAX_WBITS, MAX_MEM_LEVEL));
 	inf_strm.workspace = vmalloc(zlib_inflate_workspacesize());
-	if (!inf_strm.workspace) {
-		vfree(def_strm.workspace);
+	if (!inf_strm.workspace)
 		return -ENOMEM;
-	}
 	jffs2_dbg(1, "Allocated %d bytes for inflate workspace\n",
 		  zlib_inflate_workspacesize());
 	return 0;
@@ -61,7 +44,6 @@
 
 static void free_workspaces(void)
 {
-	vfree(def_strm.workspace);
 	vfree(inf_strm.workspace);
 }
 #else
@@ -69,75 +51,6 @@
 #define free_workspaces() do { } while(0)
 #endif /* __KERNEL__ */
 
