config ARCH_ZX
	bool "ZTE ZX GPON ONU SoCs (ZX279128)"
	depends on ARCH_MULTI_V7
	select ARM_AMBA
	select ARM_GIC
	select ARM_GLOBAL_TIMER
	select HAVE_ARM_SCU if SMP
	select HAVE_ARM_TWD if SMP
	select MIGHT_HAVE_CACHE_L2X0
	help
	  Support for the ZTE ZX279128 dual Cortex-A9 GPON ONU SoC (ZTE ZXHN F680).
