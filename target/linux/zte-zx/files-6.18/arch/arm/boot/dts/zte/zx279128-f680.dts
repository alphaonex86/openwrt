/dts-v1/;

#include "zx279128.dtsi"

/ {
	model = "ZTE ZXHN F680";
	compatible = "zte,f680", "zte,zx279128";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		bootargs = "console=ttyAMA0,115200";
		stdout-path = "serial0:115200n8";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x40000000 0x8000000>;
	};
};

/* The GN25L95 BOSA: its SFF-8472 pages at 0x50/0x51, configured from its own memory (stock never writes it). */
&i2c0 {
	status = "okay";

	optics: bosa@51 {
		compatible = "semtech,gn25l95";
		reg = <0x51>;
	};
};

/*
 * GPIO 72 is the BOSA's TX_DISABLE (A2h 0x6e bit 7 follows it): low transmits, as stock's board table drives it.
 * The stock U-Boot holds it high; the GPON driver keeps it high until its transmitter is enabled.
 */
&eth {
	laser-enable-gpios = <&gpio4 8 1>;
	optics = <&optics>;
};
