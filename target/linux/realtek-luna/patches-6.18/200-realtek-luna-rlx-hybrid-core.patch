@@ -1705,6 +1736,46 @@ static void r4k_cache_error_setup(void)
 	}
 }
 
+#ifdef CONFIG_CPU_R3K_TLB
+/*
+ * The RLX "Taroko" core has no index-type cache instruction: a whole-cache
+ * operation is one write to its cache-control register (CP0 $20), armed by
+ * a zero first.  Only the two forms the stock firmware runs are used, each
+ * as ONE operation: the D-cache write-back+invalidate alone, or that with
+ * the I-cache invalidate.  Never one operation chained to another.
+ */
+#define LUNA_CCTL_D_WBINV	0x200
+#define LUNA_CCTL_ALL		0x202
+
+#define luna_cctl(op)						\
+	__asm__ __volatile__(					\
+		"	.set	push		\n"		\
+		"	.set	noreorder	\n"		\
+		"	mtc0	$0, $20		\n"		\
+		"	li	$8, %0		\n"		\
+		"	mtc0	$8, $20		\n"		\
+		"	.set	pop		\n"		\
+		: : "i" (op) : "$8", "memory")
+
+static void luna_blast_dcache(void)
+{
+	luna_cctl(LUNA_CCTL_D_WBINV);
+}
+
+static void luna_blast_all(void)
+{
+	luna_cctl(LUNA_CCTL_ALL);
+}
+
+/* An executable range that goes away: drop its instructions, as stock does. */
+static void luna_flush_cache_range(struct vm_area_struct *vma,
+				   unsigned long start, unsigned long end)
+{
+	if ((vma->vm_flags & VM_EXEC) && has_valid_asid(vma->vm_mm, R4K_INDEX))
+		luna_blast_all();
+}
