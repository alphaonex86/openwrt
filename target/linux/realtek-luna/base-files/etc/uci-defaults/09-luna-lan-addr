#!/bin/sh
#
# ★★★ STOP THIS BOARD CLAIMING ANOTHER BOARD'S LAN ADDRESS.
#
# `/etc/config/network` in this target is a FIXED FILE shipped verbatim to every
# board, and it hardcodes `network.lan.ipaddr = 192.168.1.1`. That address was
# chosen for the X111W bring-up. It is not free:
#
#   MEASURED 2026-08-20, on the lab rig, before this file existed:
#     192.168.1.1 dev eth0 lladdr 98:c7:a4:6c:af:cb REACHABLE
#   -- that is the X400AXF on bench `onu`, LIVE, on the SAME L2 segment as the
#   two other ONUs. The moment the LANLY G24W gained a working Ethernet driver,
#   booting this image would have put a SECOND host on 192.168.1.1 and started
#   ARP-flapping another agent's board mid-measurement.
#
# ⚠ AND IT WOULD HAVE BEEN SILENT. Nothing in the image, the build or the suite
# checks that two boards were handed the same address; the first symptom would
# have been somebody else's ssh session dying for no visible reason, on a bench
# nobody had touched.
#
# ★ THIS FILE IS A SYMPTOM, NOT THE CURE. The real defect is already declared in
# the project's own rules: our side is supposed to be generated by
# `config_generate(8)` / `board.d` from the board's declaration and its DT, and
# shipping ONE board's fixed topology to every board on the target is what
# disables that. Until the generator lands, this restores the ONE value that can
# do cross-board damage, and it does so per board, from the board's own name.
#
# ★ WHY uci-defaults AND NOT AN EDIT TO THE SHIPPED FILE: editing
# `/etc/config/network` would change the X111W and the RTL9607C engineering
# board too, and neither has been re-measured today. This is ADDITIVE: a board
# that is not named below is left byte-for-byte as it was.
#
# ★ THE ADDRESSES ARE EACH BOARD'S OWN DECLARED VALUE (`ONU_LAN_IP` in its
# `instrument/<SOC>/<BRAND>/<MODEL>/config.xml`), so the image and the test
# suite agree by construction rather than by coincidence.

board=""
[ -r /tmp/sysinfo/board_name ] && board=$(cat /tmp/sysinfo/board_name)

case "$board" in
lanly,g24w)
	# bench onu3. Declared ONU_LAN_IP = 192.168.1.11, and stock on this unit
	# answers telnet at the same address -- so the board keeps ONE identity
	# across both firmwares.
	uci -q set network.lan.ipaddr='192.168.1.11'
	uci -q commit network
	logger -t luna-lan-addr "board_name=$board -> lan 192.168.1.11 (the shipped default 192.168.1.1 belongs to another bench)"
	;;
"")
	# THREE STATES: we could not ask which board this is. Change NOTHING --
	# guessing here is how the wrong address gets applied to the wrong board,
	# which is the exact failure this file exists to prevent.
	logger -t luna-lan-addr "board_name unreadable -- LAN address left as shipped"
	;;
*)
	# A board with no entry keeps the shipped value, deliberately. Silence
	# here means "nobody has declared this board's address", not "0.0.0.0 is
	# fine" -- and it is visible in the log rather than merely absent.
	logger -t luna-lan-addr "board_name=$board has no declared LAN address -- left as shipped"
	;;
esac

exit 0
