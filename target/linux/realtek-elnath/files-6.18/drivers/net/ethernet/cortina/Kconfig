# Cortina ethernet devices

config NET_VENDOR_CORTINA
	bool "Cortina Gemini devices"
	default y
	help
	  If you have a network (Ethernet) card belonging to this class, say Y
	  and read the Ethernet-HOWTO, available from
	  <https://www.tldp.org/docs.html#howto>.

if NET_VENDOR_CORTINA

config GEMINI_ETHERNET
	tristate "Gemini Gigabit Ethernet support"
	depends on OF
	depends on HAS_IOMEM
	select PHYLIB
	select CRC32
	help
	  This driver supports StorLink SL351x (Gemini) dual Gigabit Ethernet.

config CORTINA_NI
	tristate "Cortina-Access RTL9607F NI (network engine) Ethernet"
	depends on OF
	depends on HAS_IOMEM
	select PHYLIB
	help
	  This driver supports the Cortina-Access NI packet engine found in
	  the Realtek RTL9607F "Elnath" GPON SoC, including its internal
	  MDIO bus and quad GbE PHYs.

config CORTINA_NI_FLOWOFFLOAD
	bool "Cortina-Access NI L3FE nf_flow_table hardware flow offload"
	depends on CORTINA_NI
	default y
	select GPON_FLOW_OFFLOAD	# the COMMON TC lifecycle, drivers/net/gpon/
	help
	  Drive the NE L3FE "main hash" flow engine (64K-entry NAPT
	  accelerator, mtk_ppe class) as an nf_flow_table hardware offload
	  backend on the RTL9607F "Elnath": ndo_setup_tc(TC_SETUP_FT/BLOCK)
	  flow_block glue, the software-computed CRC32/CRC16 install path,
	  age-based go-live/teardown and the batch liveness sweep.  When
	  disabled (or when the engine fails bring-up) every offload request
	  is refused and traffic stays on the normal software path.

config CORTINA_DEBUG
	bool "Cortina NI bring-up diagnostics (first-frame RX/TX dumps, DS-WAN spy)"
	depends on CORTINA_NI
	default n
	help
	  The FAMILY member of the per-category debug set, the Cortina twin of
	  LUNA_DEBUG: it compiles in the rx_debug / tx_debug knobs and what they
	  gate -- the first-frame descriptor/frame hex dumps and the DS-WAN DHCP
	  delivery spy. Off, the knobs are constant false, so the per-packet
	  test they cost on the RX and TX hot paths is gone too. MEASURED
	  2026-09-23 (gcc, aarch64): cortina-ni-rx.o text 73616 -> 72622,
	  cortina-ni-tx.o 13582 -> 13244 with it off -- about 1.3 KB.

config CORTINA_NI_REG_GUARD
	bool "Bound-check indexed register writes (debug)"
	depends on CORTINA_NI
	help
	  Warn once, naming the array and the index, when an indexed register
	  write goes past the array's declared entry count.

	  The hardware accepts a write to the wrong address silently, and no
	  compiler or sanitizer can see it: these are MMIO writes through an
	  ioremapped window, so there is no allocation to bound-check.  This is
	  the runtime half of the register-map guard -- it catches an index that
	  only goes out of range while running, which a build-time check cannot.

	  Costs nothing when off.  Say N for a shipping image.

config CORTINA_GPON
	tristate "Cortina-Access RTL9607F GPON MAC"
	depends on OF
	depends on HAS_IOMEM
	select CRC32
	select GPON_CORE	# shared core: drivers/net/gpon/Kconfig
	#: ★ THIS board has a flow accelerator (the L3FE), so it takes the
	#: shared TC-offload lifecycle too.  A family without an engine simply
	#: does not select this and carries none of it -- the operator's
	#: "#ifdef" (2026-08-28), expressed where Kconfig can enforce it.
	#: ★★★ BUT THE SELECT MOVED TO CORTINA_NI_FLOWOFFLOAD (2026-09-08).
	#: Selecting it HERE welded the accelerator to the driver: the board
	#: could not be built with the offload OFF, and the AQM-vs-offload
	#: trade-off is an OPERATOR DECISION TAKEN WITH NUMBERS -- which needs
	#: both states buildable.  The prompted symbol now owns the select.
	help
	  This driver supports the Cortina-Access GPON MAC (CA8277C class)
	  found in the Realtek RTL9607F "Elnath" GPON ONU SoC: the PON-MAC
	  register block, PSDS SerDes optics, PLOAM servicing and the GEM
	  datapath.  Clean-room re-expression of the Cortina ca-network-engine.

endif # NET_VENDOR_CORTINA
