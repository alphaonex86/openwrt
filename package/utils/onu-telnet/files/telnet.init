#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later
# LAN-only telnet: bound to the LAN address, never a socket on the WAN side.

START=50
STOP=10
USE_PROCD=1

start_service() {
	local lan_ip

	. /lib/functions/network.sh
	network_get_ipaddr lan_ip lan
	[ -n "$lan_ip" ] || lan_ip="192.168.1.1"

	procd_open_instance
	procd_set_param command /usr/sbin/telnetd -F -b "${lan_ip}:23" -l /bin/login
	# retry 0: a bare respawn stops for good after five deaths
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_interface_trigger lan
}
