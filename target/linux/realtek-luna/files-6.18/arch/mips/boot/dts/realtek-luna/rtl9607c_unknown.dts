/dts-v1/;

#include "rtl9607c.dtsi"

/ {
	model = "UNKNOWN UNKNOWN (RTL9607C, console bring-up)";
	compatible = "unknown,rtl9607c-unknown", "realtek,rtl9607c", "rtk,8198d";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	/* This unit's low RAM map, bounded by bdinfo's 256 MiB; fitted RAM is unknown. */
	memory@0 {
		reg = <0x00000000 0x0bbff000>, <0x0c000000 0x03bff000>;
	};

	reserved-memory {
		/delete-node/ ipc-shm@10000000;

		pbo-dl@bbff000 {
			no-map;
			reg = <0x0bbff000 0x00401000>;
		};

		pbo-ul@fbff000 {
			no-map;
			reg = <0x0fbff000 0x00401000>;
		};
	};

	/delete-node/ board_setting;
	/* Panel buttons and lamps, from this unit's native kernel (its push-button and
	 * LED board hooks): every button reads pressed = low; the power lamp is lit
	 * high, the others low. GPIO 20 (its phone lamp) is left out. */
	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <100>;

		button-reset {
			label = "reset";
			linux,code = <0x198>;	/* KEY_RESTART */
			gpios = <&gpio1 5 1>;	/* GPIO 37 */
		};

		button-wps {
			label = "wps";
			linux,code = <0x211>;	/* KEY_WPS_BUTTON */
			gpios = <&gpio1 2 1>;	/* GPIO 34 */
		};

		button-wifi {
			label = "wifi";
			linux,code = <0xf7>;	/* KEY_RFKILL */
			gpios = <&gpio1 4 1>;	/* GPIO 36 */
		};

		button-led {
			label = "led";
			linux,code = <0x21e>;	/* KEY_LIGHTS_TOGGLE */
			gpios = <&gpio0 7 1>;	/* GPIO 7 */
		};
	};

	leds {
		compatible = "gpio-leds";

		led-power {
			label = "green:power";
			gpios = <&gpio1 28 0>;	/* GPIO 60 */
			default-state = "on";
		};

		led-net {
			label = "green:net";
			gpios = <&gpio1 25 1>;	/* GPIO 57 */
		};

		led-wps {
			label = "green:wps";
			gpios = <&gpio1 24 1>;	/* GPIO 56 */
		};
	};

	/* ethernet@18012000 KEPT (2026-09-29): luna_eth binds it and needs none of
	 * the nodes deleted here; the LAN address comes from 09-luna-lan-addr (.14). */
	/delete-node/ switch@0;
	/delete-node/ soft_ipc@18141180;
	/delete-node/ usb@0;
	/delete-node/ usb@1;
	/delete-node/ usb@2;
};

/* 256 MiB Micron MT29F2G01ABAGD, the vendor BCH6 layout (on-die ECC off). U-Boot's map:
 * UBI 0x140000-0xfb00000 holds both banks (ubi_k0/r0 native, ubi_k1/r1 ours).
 * Writable: the U-Boot environment (bank variables) and UBI (bank 1); U-Boot, static_conf and
 * the tail stay read-only. Fork 5dbe2493e2 is the all-read-only image for a first read proof. */
&snand {
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		nand-ecc-engine = <&nand_ecc>;
		nand-ecc-strength = <6>;
		nand-ecc-step-size = <512>;
		nand-ecc-algo = "bch";
		nand-ecc-placement = "oob";

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "boot";
				reg = <0x0 0xc0000>;
				read-only;
			};

			partition@c0000 {
				label = "env";
				reg = <0xc0000 0x20000>;
			};

			partition@e0000 {
				label = "env2";
				reg = <0xe0000 0x20000>;
			};

			partition@100000 {
				label = "static_conf";
				reg = <0x100000 0x40000>;
				read-only;
			};

			partition@140000 {
				label = "ubi";
				reg = <0x140000 0xf9c0000>;
			};

			partition@fb00000 {
				label = "reserved";
				reg = <0xfb00000 0x500000>;
				read-only;
			};
		};
	};
};

&nand_ecc {
	status = "okay";
};
