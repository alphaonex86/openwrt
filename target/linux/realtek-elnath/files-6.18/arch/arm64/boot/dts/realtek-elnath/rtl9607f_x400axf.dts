// SPDX-License-Identifier: GPL-2.0-or-later

/dts-v1/;

#include "rtl9607f.dtsi"

/ {
	model = "HSGQ X400AXF (Realtek RTL9607F Elnath)";
	compatible = "hsgq,x400axf", "realtek,rtl9607f";


	aliases {
		serial0 = &uart0;
	};


	chosen {
		stdout-path = "serial0:115200n8";
		/* ubi.mtd: auto-attach the stock NAND UBI (READ-ONLY - every
		 * partition below carries read-only, so UBI attaches in ro
		 * mode) so early boot can read the per-board factory
		 * provisioning (ubi_Config/config_hs.xml: ELAN_MAC_ADDR,
		 * GPON_SN).  We still run from the RAM initramfs. */
		bootargs = "earlycon console=ttyS0,115200 rootfstype=squashfs ubi.mtd=ubi_device";
	};


	memory@0 {
		device_type = "memory";
		/* 512 MiB at 0x0 */
		reg = <0x00 0x00 0x00 0x20000000>;
	};


	/*
	 * Front-panel LEDs.  The panel carries twelve: PWR, PON, LOS, NET, LAN1-4,
	 * 2.4G, 5G, WPS, FXS1 (operator-confirmed).  The ten below are the ones on
	 * SoC GPIO; 2.4G and 5G are NOT — they hang off each WiFi chip's own LED pad
	 * and so cannot be declared here, because no SoC GPIO reaches them (a guessed
	 * GPIO would drive some other net).  They are not a gap any more: each pad is
	 * the WiFi MAC's GPIO 8, and our rtw89 registers a led_classdev per radio for
	 * it (drivers/net/wireless/realtek/rtw89/led.c, CONFIG_RTW89_LEDS), naming
	 * them x400axf:green:2.4g and x400axf:green:5g to match the ten below.
	 * mac80211's throughput trigger then holds each one on while its radio is up.
	 * Do NOT add them to this node.
	 *
	 * Pin numbers come from the stock firmware's own device tree, whose vendor
	 * LED node spells each LED as <gpio-bank-phandle, pin-in-bank, flags> —
	 * the ordinary OF GPIO specifier, as its sibling standard gpio-keys node
	 * proves.  Flags are 0 on every LED there, i.e. ACTIVE HIGH, and that is
	 * independently confirmed by live stock register values: at Online the
	 * group-0 OUT word drives pin 6 (PWR) HIGH with pins 11 (LOS) and 12 (FXS)
	 * LOW, and the group-3 OUT word drives pin 4 (PON) HIGH — exactly a running
	 * ONU with a good fibre.  The set of pins stock configures as group-3
	 * OUTPUTS is precisely this LED list plus the xgphy reset, which is what
	 * makes the decode certain rather than plausible.
	 *
	 * The stock tree ALSO declares LED_USB0/LED_USB1; this board has no USB
	 * port, so they are deliberately absent here.  That stock tree is a FAMILY
	 * device tree — it covers models with USB, and conversely has no WiFi LED
	 * although this board does.  Do not "restore" the USB entries from it.
	 *
	 * Names are OpenWrt-idiomatic <board>:<colour>:<function>; the vendor label
	 * is kept in a comment so the mapping stays traceable.  Colours: the vendor
	 * _G suffix means green (PWR/NET/WPS); PON green and LOS red are the
	 * project's stated stock behaviour.  LAN and FXS1 colours are assumed green
	 * and are cosmetic — they affect only the sysfs name, never a pin.
	 */
	/*
	 * The UNI panel this board presents over OMCI, MEASURED from its own
	 * stock firmware (omcicli mib get 11/264, 2026-09-13).
	 *
	 * ME 11 (PPTP Ethernet UNI) and ME 264 (UNI-G) are SEPARATE lists and
	 * neither is derivable from the other.  This board carries a fifth UNI-G,
	 * 0x0604, with no Ethernet UNI beside it and management capability 0
	 * where the other four report 1.  Its PhysicalPortId runs 3,2,1,0 over
	 * 0x0101..0x0104 -- the OPPOSITE order to the G24W's, which is why no
	 * code here computes a port from an instance.
	 *
	 * The ids are full 16-bit OMCI instance numbers, not port indices.
	 */
	omci-uni {
		ethernet-uni-instances = /bits/ 16 <0x0101 0x0102 0x0103 0x0104>;
		/* The SWITCH PORT each of those instances is, from this board's OWN mapper at 0x3bd08, replayed against its captured gInfo
		 * for BOTH feature-50 states, and agreeing with its own PhysicalPortId.
		 * ⚠ NEVER COMPUTED: the two Luna boards and the Cortina one run
		 * their port order in OPPOSITE directions, and one numbers its
		 * fourth UNI 0x0401, so no arithmetic on an instance id is
		 * right on more than one board. */
		ethernet-uni-ports = /bits/ 8 <3 2 1 0>;
		uni-g-instances = /bits/ 16 <0x0101 0x0102 0x0103 0x0104 0x0604>;
		uni-g-management-capability = /bits/ 8 <1 1 1 1 0>;
		/* The rest of what the OLT counts, from this board's own stock MIB
		 * (stock_gpon_oracle 2026-09-30, omci_panel.py): no circuit pack,
		 * three IP hosts without a MAC, 30 T-CONTs and schedulers, ONU2-G
		 * 248 queues / 248 GEM ports, and the downstream queue blocks in
		 * stock's order. */
		ethernet-uni-types = /bits/ 8 <47 47 47 47>;
		circuit-packs;
		ip-host-instances = /bits/ 16 <0x0000 0x0001 0x0002>;
		ip-host-wan-mac = /bits/ 8 <0 0 0>;
		onu-capacity = /bits/ 16 <30 248 30 248>;
		downstream-queue-ports = /bits/ 16 <0x0104 0x0103 0x0102 0x0101 0x0601>;
	};


	leds {
		compatible = "gpio-leds";

		/* LED_PWR_G — group 0 pin 6.  On for the whole time we are up. */
		led-power {
			label = "x400axf:green:power";
			gpios = <&gpio0 0x06 0x00>;
			default-state = "on";
		};

		/* LED_PON — group 3 pin 4.  Driven by the panel daemon from the
		 * GPON activation state (solid at O5, blinking while ranging). */
		led-pon {
			label = "x400axf:green:pon";
			gpios = <&gpio3 0x04 0x00>;
			default-state = "off";
		};

		/* LED_LOS — group 0 pin 11.  Daemon-driven: on ONLY while the
		 * downstream optical signal is lost. */
		led-los {
			label = "x400axf:red:los";
			gpios = <&gpio0 0x0b 0x00>;
			default-state = "off";
		};

		/* LED_PPP_G — group 3 pin 12.  The panel silkscreen calls this
		 * NET: internet/WAN reachability, daemon-driven from the WAN
		 * interface state (PPPoE session up, or a WAN default route). */
		led-net {
			label = "x400axf:green:net";
			gpios = <&gpio3 0x0c 0x00>;
			default-state = "off";
		};

		/*
		 * LED_EPHY0..3 — the four RJ45 link LEDs, group 3 pins 6/3/1/7.
		 *
		 * ★★ TWO SEPARATE FACTS LIVE IN THESE FOUR NODES, and only the
		 * second one was ever in doubt.  Keeping them apart is what makes
		 * the block reviewable, so read them as two:
		 *
		 * (1) WHICH SWITCH PORT each lamp tracks — PROVEN, and unchanged
		 *     by this revision.  Re-verified 2026-08-12 against the stock
		 *     firmware, including a fresh `dtc -I dtb` of the raw blob
		 *     (mtd6_ubi_DTB0.bin) to confirm the decompiled copy on disk
		 *     is faithful.  FOUR independent places in that firmware
		 *     agree, and they are worth naming because this is the half
		 *     that must never be "simplified":
		 *       · its rtk_gpio_led node — LED_EPHY0..3 =
		 *         <&bank3 6/3/1/7>, flags 0 (active high);
		 *       · etc/scripts/board_init.sh + set_lan_disable.sh —
		 *         LED_EPHY0..3 device_name = eth0.2/.3/.4/.5;
		 *       · its switchdev node — port@N id=N netdev-name
		 *         eth0.(N+2), phy-handle phy(N+1);
		 *       · its disabled hardware port-LED block — led@N
		 *         port=<N> device_name="eth0.(N+2)".
		 *     So:
		 *         pin 6 = EPHY0 = port 0     pin 1 = EPHY2 = port 2
		 *         pin 3 = EPHY1 = port 1     pin 7 = EPHY3 = port 3
		 *     Every node below keeps its own pin<->port pairing; that
		 *     pairing is the part nobody may change without new evidence.
		 *
		 * (2) WHICH PRINTED SOCKET each lamp sits beside — this is what
		 *     was WRONG here, and the previous revision of this comment
		 *     predicted it in as many words ("the lanN NAME may be
		 *     reversed").  It is now settled: the operator's cable check
		 *     (2026-07-26, re-confirmed 2026-07-29, one socket at a time,
		 *     reading which port reported link) measured the panel as
		 *     MIRRORED —
		 *         LAN1 = port 3      LAN3 = port 1
		 *         LAN2 = port 2      LAN4 = port 0
		 *     and a shipped product lights the lamp beside the socket it
		 *     is reporting on, so the lamp beside printed LAN1 is the one
		 *     tracking port 3 = LED_EPHY3 = pin 7.  The labels below have
		 *     been moved onto the right pins accordingly.  The previous
		 *     revision named the lamp beside socket LAN4 "lan1", i.e. it
		 *     lit the far end of the panel from the cable.
		 *
		 *     ⚠ AND (2) CANNOT BE SETTLED FROM SOFTWARE — searched
		 *     2026-08-12 across the whole stock DTS, /etc (incl. every
		 *     script), the web UI and bin/lib/usr: the vendor firmware
		 *     asserts NOTHING anywhere about the silkscreen.  What it
		 *     does contain runs the OTHER way — set_lan_disable.sh
		 *     comments its PHY writes "#LAN0"→port 0 … "#LAN3"→port 3,
		 *     and the web UI's common.js legend reads "bit0 - LAN 1",
		 *     i.e. the vendor's SOFTWARE numbers the sockets ascending
		 *     with the port index.  That is not a refutation — a case
		 *     silkscreen is a mechanical fact the firmware never states,
		 *     and the operator's cable check is a live measurement on
		 *     THIS unit, which outranks a vendor script comment — but it
		 *     does mean the only instrument that can close this question
		 *     is an eye on the panel, which is what the check below is.
		 *
		 * ★ We cannot use the netdev trigger here: our clean-room NI
		 * driver registers ONE netdev (eth0) for the whole switch, not a
		 * per-port subdevice, so there is no netdev to bind per RJ45 and
		 * all four would report the CPU port.  cortina_ni therefore
		 * publishes one trigger per SWITCH PORT, driven from the per-port
		 * PHY link it already polls at 1 Hz (cortina-ni-leds.c), and the
		 * linux,default-trigger lines below ARE the panel map, expressed
		 * as data: a board wired the other way round changes these four
		 * strings and no code.  Difference from stock, stated plainly:
		 * these show LINK only; stock's trigger did link+tx+rx, so its
		 * lamps also blinked on traffic.
		 *
		 * ⚠ FALSIFIABLE, AND SETTLED BY EYE IN ONE GLANCE: with the cable
		 * in the socket printed LAN1, the lamp that lights must be the
		 * one printed LAN1.  If the lamp beside LAN4 lights instead, then
		 * fact (2) is wrong for this board — the vendor mirrored its own
		 * panel — and the repair is to swap the gpios= lines among these
		 * four nodes, keeping each label WITH its linux,default-trigger.
		 * Do NOT instead edit the trigger strings: that would light the
		 * correct lamp again while putting the sysfs NAME back out of
		 * agreement with the socket, which is the defect being fixed.
		 */
		led-lan1 {
			label = "x400axf:green:lan1";	/* LED_EPHY3, pin 7 */
			gpios = <&gpio3 0x07 0x00>;
			linux,default-trigger = "cortina-ni-port3-link";
			default-state = "off";
		};

		led-lan2 {
			label = "x400axf:green:lan2";	/* LED_EPHY2, pin 1 */
			gpios = <&gpio3 0x01 0x00>;
			linux,default-trigger = "cortina-ni-port2-link";
			default-state = "off";
		};

		led-lan3 {
			label = "x400axf:green:lan3";	/* LED_EPHY1, pin 3 */
			gpios = <&gpio3 0x03 0x00>;
			linux,default-trigger = "cortina-ni-port1-link";
			default-state = "off";
		};

		led-lan4 {
			label = "x400axf:green:lan4";	/* LED_EPHY0, pin 6 */
			gpios = <&gpio3 0x06 0x00>;
			linux,default-trigger = "cortina-ni-port0-link";
			default-state = "off";
		};

		/* LED_WPS_G — group 3 pin 0.  Declared so the pad is owned and
		 * scriptable; we ship no WPS registrar, so nothing drives it. */
		led-wps {
			label = "x400axf:green:wps";
			gpios = <&gpio3 0x00 0x00>;
			default-state = "off";
		};

		/* LED_FXS — group 0 pin 12.  The panel has an FXS1 indicator, but
		 * we drive no voice stack, so this is declared only. */
		led-fxs1 {
			label = "x400axf:green:fxs1";
			gpios = <&gpio0 0x0c 0x00>;
			default-state = "off";
		};
	};


	/*
	 * Reset and WPS buttons (both on the side of the case, operator-confirmed).
	 * Pins and key codes are the stock device tree's own gpio-keys node, which
	 * uses the identical <bank pin flags> form as the LEDs above: reset =
	 * group 4 pin 8, WPS = group 3 pin 16, both ACTIVE LOW.  Stock's live
	 * register state corroborates it — group 4 pin 8 is the one pin in that
	 * group left as an INPUT while its neighbours are driven outputs.
	 *
	 * POLLED, not interrupt-driven: our GPIO driver implements no irqchip, and
	 * OpenWrt's gpio-button-hotplug refuses a plain "gpio-keys" node whose
	 * lines cannot be mapped to an IRQ.  A button is a human-timescale input,
	 * so a 100 ms poll is indistinguishable in use.
	 *
	 * The stock tree also has a third button (WiFi on/off, group 3 pin 15).
	 * This panel has only reset and WPS, so it is left out.
	 */
	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <0x64>;		/* 100 ms */

		button-reset {
			label = "reset";
			linux,code = <0x198>;	/* KEY_RESTART */
			gpios = <&gpio4 0x08 0x01>;
		};

		button-wps {
			label = "wps";
			linux,code = <0x211>;	/* KEY_WPS_BUTTON */
			gpios = <&gpio3 0x10 0x01>;
		};
	};
};

&qspi {
	nand@0 {
		compatible = "spi-nand";
		reg = <0x00>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <0x01>;
			#size-cells = <0x01>;

			partition@0 {
				label = "boot";
				reg = <0x0 0x200000>;
				read-only;
			};
			partition@280000 {
				label = "env";
				reg = <0x280000 0x40000>;
				read-only;
			};
			partition@2c0000 {
				label = "env2";
				reg = <0x2c0000 0x40000>;
				read-only;
			};
			partition@300000 {
				label = "static_conf";
				reg = <0x300000 0x40000>;
				read-only;
			};
			partition@340000 {
				label = "ubi_device";
				reg = <0x340000 0x7cc0000>;
				read-only;
			};
		};
	};
};
