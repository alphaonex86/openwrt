#!/bin/sh
# Datapath fastpath defaults -- TAROKO ONLY, deliberately.
#
# ★ WHY IT IS IN THE SUBTARGET AND NOT IN realtek-luna/base-files. Both Luna
# subtargets would benefit -- the software flowtable needs no accelerator -- but
# enabling it target-wide changes the SHIPPED DATAPATH of a board whose owner
# did not ask for it, silently, possibly mid-certification. The G24W adopts this
# by moving the file up one level, which is a one-line decision for whoever owns
# that board and not a side effect of this one.
#
# ★ WHY THIS FILE ARRIVED LATE (2026-09-11).  The Elnath target has shipped the
# same two lines since 2026-07-24; this target shipped NEITHER, so on the X111W
# every forwarded packet took the full netfilter slow path -- there was no
# flowtable at all, software or hardware.  That is one of the three reasons the
# board software-forwarded: no flowtable, `rtl9602c_eth.hw_nat` defaulting to 0,
# and an install that refused unconditionally.
#
#  - flow_offloading:    the SOFTWARE flowtable fastpath, so a forwarded
#    LAN<->WAN flow bypasses the netfilter slow path after its first packet.
#    It needs no accelerator and helps on any board.
#  - flow_offloading_hw: adds `flags offload` to the fw4 flowtable, so
#    nf_flow_table offers each flow to the driver through ndo_setup_tc.  On
#    this family that reaches rtl9602c_l34_tc.c, which provisions the L34
#    interface tables from the live kernel edge and then programs a NAPT entry.
#    With `rtl9602c_eth.hw_nat=0` the driver has no engine handle and REFUSES
#    the block bind, so flows simply stay on the software flowtable -- the
#    knob is safe to ship on either setting of hw_nat.
uci -q batch <<-EOF
	set firewall.@defaults[0].flow_offloading='1'
	set firewall.@defaults[0].flow_offloading_hw='1'
	commit firewall
	EOF
exit 0
