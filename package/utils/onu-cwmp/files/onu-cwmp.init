#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later
# The TR-069 CPE a unit answers its ISP's ACS with, on that ISP's management interface alone.

START=99
USE_PROCD=1

start_service() {
	local enabled url user pass iface agent dev dns

	config_load cwmp
	config_get_bool enabled acs enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get url acs url
	config_get user acs username
	config_get pass acs password
	config_get iface acs interface
	config_get agent acs user_agent onu-cwmp
	[ -s /etc/cwmp/model.tsv ] || { logger -t onu-cwmp "no data model in /etc/cwmp/model.tsv"; return 0; }
	. /lib/functions/network.sh
	network_get_device dev "$iface" || { logger -t onu-cwmp "interface $iface is not up: started when it is"; return 0; }
	# the management DNS the PPP link gave, kept out of the system resolver (peerdns 0)
	dns=$(ifstatus "$iface" | jsonfilter -e '@["dns-server"][0]' -e '@.inactive["dns-server"][0]' | head -1)
	procd_open_instance
	procd_set_param command /usr/sbin/onu-cwmp -u "$url" -U "$user" -P "$pass" -m /etc/cwmp/model.tsv \
		-n /etc/cwmp/inform-names.txt -i "$dev" -a "$agent" ${dns:+-d "$dns"}
	procd_set_param respawn 3600 30 0
	procd_close_instance
}

service_triggers() {
	local iface

	config_load cwmp
	config_get iface acs interface
	[ -n "$iface" ] && procd_add_interface_trigger "interface.*" "$iface" /etc/init.d/onu-cwmp restart
	procd_add_reload_trigger cwmp
}
