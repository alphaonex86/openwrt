# This boot's record and the kernel's panics in the flash, and its clean end, from a boot of our own flash bank only.
START=13	# after the log daemon (12): a recorder that did not start must say so
STOP=90

boot() {
	crashlog arm
}

shutdown() {
	crashlog shutdown
}
