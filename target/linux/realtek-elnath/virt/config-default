# The QEMU virt machine replaces the SoC: its UART, PCIe host, RTC and virtio NICs on, the Cortina drivers off.
CONFIG_CMDLINE="earlycon console=ttyAMA0,115200 cfg80211.ieee80211_regdom=BO"
# CONFIG_CMDLINE_FORCE is not set
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_RTC_DRV_PL031=y
CONFIG_PCI_HOST_COMMON=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LIB=y
CONFIG_VIRTIO_PCI_LIB_LEGACY=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_NET=y
CONFIG_NET_FAILOVER=y
CONFIG_FAILOVER=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_PON_VIRT=y
# CONFIG_CORTINA_GPON is not set
# CONFIG_CORTINA_NI is not set
# CONFIG_CORTINA_NI_FLOWOFFLOAD is not set
# CONFIG_PCIE_CORTINA is not set
# CONFIG_GPIO_CORTINA_CA77XX is not set
# CONFIG_SERIAL_CORTINA is not set
# CONFIG_SERIAL_CORTINA_CONSOLE is not set
# CONFIG_SPI_CORTINA_QSPI is not set
# CONFIG_CORTINA_WDT is not set
# CONFIG_NSM is not set
# CONFIG_VIRTIO_BLK is not set
# CONFIG_VIRTIO_DEBUG is not set
